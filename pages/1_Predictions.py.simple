import pandas as pd
import numpy as np
import plotly.graph_objects as go
import streamlit as st

from utils import load_data

# ── Constants ──────────────────────────────────────────────────────────────────
PROD_COL = 'production_solaire/m2(en Kwh)'
PRED_COL = 'production_solaire/m2(en Kwh) J+1 predit'

# ── Data ───────────────────────────────────────────────────────────────────────
solar_prod_df = load_data()

# ── Sidebar ────────────────────────────────────────────────────────────────────
with st.sidebar:
    st.header('Filters')

    selected_date = st.date_input(
        'Select a date',
        value=pd.Timestamp('2026-01-01').date(),
        min_value=solar_prod_df['date'].min().date(),
        max_value=(solar_prod_df['date'].max() + pd.Timedelta(days=2)).date()
    )

    all_regions          = sorted(solar_prod_df['region'].unique())
    selected_region_name = st.selectbox('Region', ['All regions'] + all_regions, index=0, key='region_selectbox')
    selected_regions     = all_regions if selected_region_name == 'All regions' else [selected_region_name]

    solar_panels_surface = st.slider('Panel surface (m²)', min_value=10, max_value=10_000, value=100, step=10)

# ── Filter ─────────────────────────────────────────────────────────────────────
df_day = solar_prod_df.loc[
    (solar_prod_df['date'] == pd.Timestamp(selected_date)) &
    (solar_prod_df['region'].isin(selected_regions))
]

is_future  = selected_date > solar_prod_df['date'].max().date()
has_data   = not df_day.empty
pred_val   = df_day[PRED_COL].mean()   if has_data and PRED_COL in df_day.columns else None
actual_val = df_day[PROD_COL].mean()   if has_data and PROD_COL in df_day.columns else None

# ── Title ──────────────────────────────────────────────────────────────────────
region_str = selected_region_name if selected_region_name != 'All regions' else 'All regions'
st.title(f'☀️ Solar Production Prediction — {selected_date}')
st.caption(f'Region: {region_str} · Panel surface: {solar_panels_surface} m²')

if is_future:
    st.info('🔮 Future date selected — showing prediction only, no actual data available.')

if not has_data:
    st.warning('No data available for the selected date and region.')
    st.stop()

st.divider()

# ── Weather conditions ─────────────────────────────────────────────────────────
if not is_future:
    st.subheader('🌤️ Weather Conditions')
    w1, w2, w3, w4 = st.columns(4)
    with w1:
        st.metric('Temperature', f'{df_day["daily_avg_temp"].mean():.1f} °C')
    with w2:
        st.metric('Rainfall', f'{df_day["rainfall"].mean():.2f} mm')
    with w3:
        st.metric('Wind speed', f'{df_day["daily_avg_wind_speed"].mean():.2f} m/s')
    with w4:
        st.metric('Visible radiation', f'{df_day["visible_radiation"].mean():.1f} J/cm²')

    st.divider()

# ── Prediction KPIs ────────────────────────────────────────────────────────────
st.subheader('🔮 Predictions J+1')

p1, p2, p3 = st.columns(3)

if pred_val is not None:
    with p1:
        st.metric(
            label='Predicted production (KWh/m²)',
            value=f'{pred_val:.3f}',
            help='Predicted solar production per m² of panel for the next day'
        )
    with p2:
        st.metric(
            label=f'Production for {solar_panels_surface} m² (KWh)',
            value=f'{pred_val * solar_panels_surface:.2f}',
            help=f'Predicted production scaled to your {solar_panels_surface} m² panel surface'
        )
    with p3:
        if not is_future and actual_val is not None and actual_val > 0:
            delta_pct = (pred_val - actual_val) / actual_val * 100
            st.metric(
                label='vs Actual (J)',
                value=f'{pred_val:.3f} KWh/m²',
                delta=f'{delta_pct:+.1f}% vs {actual_val:.3f}',
                delta_color='normal'
            )
        else:
            st.metric(label='Actual (J)', value='n/a', help='No actual data for future dates')

st.divider()

# ── Gauge charts ───────────────────────────────────────────────────────────────
if pred_val is not None and not is_future and actual_val is not None:
    st.subheader('📊 Predicted vs Actual')
    max_val = max(pred_val, actual_val) * 1.3

    g1, g2 = st.columns(2)

    with g1:
        fig_pred = go.Figure(go.Indicator(
            mode='gauge+number+delta',
            value=pred_val,
            delta=dict(reference=actual_val, valueformat='.3f', suffix=' KWh/m²'),
            number=dict(suffix=' KWh/m²', valueformat='.3f'),
            title=dict(text='Predicted (J+1)'),
            gauge=dict(
                axis=dict(range=[0, max_val]),
                bar=dict(color='#E67E22'),
                steps=[
                    dict(range=[0, max_val * 0.5], color='lightgray'),
                    dict(range=[max_val * 0.5, max_val], color='whitesmoke'),
                ],
                threshold=dict(line=dict(color='green', width=3), thickness=0.75, value=actual_val)
            )
        ))
        fig_pred.update_layout(height=280, margin=dict(l=20, r=20, t=40, b=20))
        st.plotly_chart(fig_pred, width='stretch')

    with g2:
        fig_actual = go.Figure(go.Indicator(
            mode='gauge+number',
            value=actual_val,
            number=dict(suffix=' KWh/m²', valueformat='.3f'),
            title=dict(text='Actual (J)'),
            gauge=dict(
                axis=dict(range=[0, max_val]),
                bar=dict(color='#2ECC71'),
                steps=[
                    dict(range=[0, max_val * 0.5], color='lightgray'),
                    dict(range=[max_val * 0.5, max_val], color='whitesmoke'),
                ],
                threshold=dict(line=dict(color='#E67E22', width=3), thickness=0.75, value=pred_val)
            )
        ))
        fig_actual.update_layout(height=280, margin=dict(l=20, r=20, t=40, b=20))
        st.plotly_chart(fig_actual, width='stretch')

    st.divider()

# ── Regional breakdown ─────────────────────────────────────────────────────────
if len(selected_regions) > 1 and PRED_COL in df_day.columns:
    st.subheader('🗺️ Regional Breakdown')

    region_df = df_day.groupby('region')[[PROD_COL, PRED_COL]].mean().reset_index()
    region_df = region_df.sort_values(PRED_COL, ascending=True)

    fig_bar = go.Figure()
    if not is_future:
        fig_bar.add_trace(go.Bar(
            y=region_df['region'], x=region_df[PROD_COL],
            orientation='h', name='Actual (J)', marker_color='#2ECC71'
        ))
    fig_bar.add_trace(go.Bar(
        y=region_df['region'], x=region_df[PRED_COL],
        orientation='h', name='Predicted (J+1)', marker_color='#E67E22'
    ))
    fig_bar.update_layout(
        barmode='group', height=400,
        xaxis_title='KWh/m²', yaxis_title='',
        legend=dict(orientation='h', y=1.08),
        margin=dict(l=20, r=20, t=40, b=20)
    )
    st.plotly_chart(fig_bar, width='stretch')
    st.divider()

# ── Note ───────────────────────────────────────────────────────────────────────
st.info("""
**ℹ️ Note on production estimation**

The estimated electric production is a **theoretical calculation**, not real-time output from a specific power plant.
It represents the energy generated per **m² of solar panel** assuming a fixed efficiency of **20%**.
Actual production may vary based on panel orientation, shading, temperature and equipment age.
""")
